{
  "info": {
    "name": "TravelWrap API",
    "description": "Colección de pruebas de la API REST de TravelWrap.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "frontendUrl",
      "value": "http://localhost:5173"
    },
    {
      "key": "viajeId",
      "value": ""
    },
    {
      "key": "tokenInvitacion",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login correcto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Incluye usuario, token y refresh_token', () => {",
                  "  pm.expect(body).to.have.property('usuario');",
                  "  pm.expect(body.usuario).to.have.property('id');",
                  "  pm.expect(body.usuario.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con credenciales incorrectas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"noexiste@travelwrap.app\",\n  \"password\": \"incorrecta123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 401', () => pm.response.to.have.status(401));",
                  "pm.test('Código credenciales_invalidas', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('credenciales_invalidas');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con email inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-es-un-email\",\n  \"password\": \"algo\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 400', () => pm.response.to.have.status(400));",
                  "pm.test('Código datos_invalidos', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('datos_invalidos');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login sin contraseña",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"daniel@travelwrap.app\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 400', () => pm.response.to.have.status(400));",
                  "pm.test('Código datos_invalidos', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('datos_invalidos');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh correcto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Incluye token y refresh_token nuevos', () => {",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh con token inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"token-invalido\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 401', () => pm.response.to.have.status(401));",
                  "pm.test('Código sesion_invalida', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('sesion_invalida');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Inicio login con Google",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/google"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 302', () => pm.response.to.have.status(302));",
                  "const destino = pm.response.headers.get('Location') || '';",
                  "pm.test('Redirige a la autorización de Supabase con Google y PKCE', () => {",
                  "  pm.expect(destino).to.include('/auth/v1/authorize');",
                  "  pm.expect(destino).to.include('provider=google');",
                  "  pm.expect(destino).to.include('code_challenge=');",
                  "  pm.expect(destino).to.include('code_challenge_method=s256');",
                  "  pm.expect(decodeURIComponent(destino)).to.include('/api/auth/google/callback');",
                  "});",
                  "const cookies = pm.response.headers.all().filter((h) => h.key.toLowerCase() === 'set-cookie').map((h) => h.value).join(' | ');",
                  "pm.test('Envía la cookie tw_oauth HttpOnly y SameSite=Lax', () => {",
                  "  pm.expect(cookies).to.include('tw_oauth=');",
                  "  pm.expect(cookies).to.include('HttpOnly');",
                  "  pm.expect(cookies).to.include('SameSite=Lax');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Callback de Google con código inválido",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/google/callback?code=codigo-invalido"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 302', () => pm.response.to.have.status(302));",
                  "pm.test('Redirige a la PWA con #error=google', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql(pm.collectionVariables.get('frontendUrl') + '/auth/callback#error=google');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Callback de Google cancelado por el usuario",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/google/callback?error=access_denied&error_description=The+user+denied+access"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 302', () => pm.response.to.have.status(302));",
                  "pm.test('Redirige a la PWA con #error=google_cancelado', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql(pm.collectionVariables.get('frontendUrl') + '/auth/callback#error=google_cancelado');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Invitaciones",
      "description": "Requiere haber ejecutado antes «Login correcto» (rellena {{token}}) y poner en {{viajeId}} el id de un viaje del que el usuario sea miembro.",
      "item": [
        {
          "name": "Obtener enlace de invitación",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/viajes/{{viajeId}}/invitacion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Incluye el token y el enlace construido con él', () => {",
                  "  pm.expect(body.token).to.match(/^[0-9a-f]{32}$/);",
                  "  pm.expect(body.enlace).to.eql(pm.collectionVariables.get('frontendUrl') + '/unirse/' + body.token);",
                  "});",
                  "pm.collectionVariables.set('tokenInvitacion', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener enlace sin sesión",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/viajes/{{viajeId}}/invitacion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 401', () => pm.response.to.have.status(401));",
                  "pm.test('Código sin_sesion', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('sin_sesion');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener enlace con id de viaje inválido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/viajes/no-es-un-uuid/invitacion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 400', () => pm.response.to.have.status(400));",
                  "pm.test('Código datos_invalidos', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('datos_invalidos');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener enlace de un viaje inexistente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/viajes/00000000-0000-4000-8000-000000000000/invitacion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 404', () => pm.response.to.have.status(404));",
                  "pm.test('Código viaje_no_encontrado', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('viaje_no_encontrado');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unirse al viaje con el enlace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/invitaciones/{{tokenInvitacion}}/unirse"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Incluye el viaje, el miembro y ya_era_miembro', () => {",
                  "  pm.expect(body.viaje.id).to.eql(pm.collectionVariables.get('viajeId'));",
                  "  pm.expect(body.viaje).to.have.property('nombre');",
                  "  pm.expect(body.miembro.rol).to.be.oneOf(['creador', 'miembro']);",
                  "  pm.expect(body.miembro.unido_en).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.ya_era_miembro).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unirse con un token inexistente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/invitaciones/00000000000000000000000000000000/unirse"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 404', () => pm.response.to.have.status(404));",
                  "pm.test('Código invitacion_no_encontrada', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('invitacion_no_encontrada');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unirse con un token mal formado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/invitaciones/token-invalido/unirse"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 404', () => pm.response.to.have.status(404));",
                  "pm.test('Código invitacion_no_encontrada', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('invitacion_no_encontrada');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unirse sin sesión",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/invitaciones/{{tokenInvitacion}}/unirse"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 401', () => pm.response.to.have.status(401));",
                  "pm.test('Código sin_sesion', () => {",
                  "  pm.expect(pm.response.json().error.codigo).to.eql('sin_sesion');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
