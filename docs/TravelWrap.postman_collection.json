    {
      "name": "Viajes",
      "description": "Requiere haber ejecutado antes «Login correcto» (rellena {{token}}). «Crear viaje con destino» rellena {{viajeId}}, que usa después la carpeta Invitaciones.",
      "item": [
        {
          "name": "Crear viaje con destino",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/viajes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Roma 2027\",\n  \"presupuesto\": 850,\n  \"destino\": \"Roma\",\n  \"fecha_inicio\": \"2027-05-12\",\n  \"fecha_fin\": \"2027-05-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Viaje activo con destino, no pendiente', () => {",
                  "  pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.nombre).to.eql('Roma 2027');",
                  "  pm.expect(body.destino).to.eql('Roma');",
                  "  pm.expect(body.estado).to.eql('activo');",
                  "  pm.expect(body.pendiente_destino).to.eql(false);",
                  "  pm.expect(Number(body.presupuesto)).to.eql(850);",
                  "});",
                  "pm.collectionVariables.set('viajeId', body.id);"
                ]
              }
            }
          ]
        },
