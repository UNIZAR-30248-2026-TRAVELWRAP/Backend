      "name": "Autenticación",
      "item": [
        {
          "name": "Login correcto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Incluye usuario, token y refresh_token', () => {",
                  "  pm.expect(body).to.have.property('usuario');",
                  "  pm.expect(body.usuario).to.have.property('id');",
                  "  pm.expect(body.usuario.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con credenciales incorrectas",
