        {
          "name": "Inicio login con Google",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/google"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 302', () => pm.response.to.have.status(302));",
                  "const destino = pm.response.headers.get('Location') || '';",
                  "pm.test('Redirige a la autorización de Supabase con Google y PKCE', () => {",
                  "  pm.expect(destino).to.include('/auth/v1/authorize');",
                  "  pm.expect(destino).to.include('provider=google');",
                  "  pm.expect(destino).to.include('code_challenge=');",
                  "  pm.expect(destino).to.include('code_challenge_method=s256');",
                  "  pm.expect(decodeURIComponent(destino)).to.include('/api/auth/google/callback');",
                  "});",
                  "const cookies = pm.response.headers.all().filter((h) => h.key.toLowerCase() === 'set-cookie').map((h) => h.value).join(' | ');",
                  "pm.test('Envía la cookie tw_oauth HttpOnly y SameSite=Lax', () => {",
                  "  pm.expect(cookies).to.include('tw_oauth=');",
                  "  pm.expect(cookies).to.include('HttpOnly');",
                  "  pm.expect(cookies).to.include('SameSite=Lax');",
                  "});"
                ]
              }
            }
          ]
        },
        {
