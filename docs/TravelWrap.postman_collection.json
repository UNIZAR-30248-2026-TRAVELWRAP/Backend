        {
          "name": "Registro correcto (crea una cuenta y envía el correo de confirmación)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombreNuevo}}\",\n  \"email\": \"{{emailNuevo}}\",\n  \"password\": \"{{passwordNuevo}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/registro"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve el usuario con el nombre y el email enviados', () => {",
                  "  pm.expect(body.usuario.nombre).to.eql(pm.collectionVariables.get('nombreNuevo'));",
                  "  pm.expect(body.usuario.email).to.eql(pm.collectionVariables.get('emailNuevo'));",
                  "});",
                  "pm.test('Pendiente de confirmar el email, o con sesión si el proyecto no lo exige', () => {",
                  "  if (body.confirmacion_pendiente) {",
                  "    pm.expect(body.confirmacion_pendiente).to.eql(true);",
                  "    pm.expect(body).to.not.have.property('token');",
                  "  } else {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
